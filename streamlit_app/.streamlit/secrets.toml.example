# Copy this file to .streamlit/secrets.toml and fill in your real values.
# NEVER commit secrets.toml (the real one) to git - add it to .gitignore.
#
# For LOCAL MySQL Workbench:
#   host = "localhost"
#   ssl_ca left blank
#
# For Aiven:
#   host / port / user / password come from your Aiven service overview page
#   download Aiven's "ca.pem" and set ssl_ca to its local file path

[mysql]
host = "127.0.0.1"
port = 3306
user = "your_username"
password = "your_password"
database = "bellabeat_fitness"
ssl_ca = ""
